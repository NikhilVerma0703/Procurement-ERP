{
  "name": "procurement-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "prisma generate && next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "tsx scripts/require-local-database.ts \"npm run db:migrate\" && prisma migrate dev",
    "db:studio": "prisma studio",
    "import:erpnext": "tsx scripts/import-erpnext.ts",
    "verify:erpnext": "tsx scripts/import-erpnext.ts --verify",
    "golden": "tsx scripts/golden-check.ts",
    "golden:stock": "tsx scripts/golden-stock.ts",
    "golden:ledger": "tsx scripts/golden-ledger.ts",
    "golden:receipts": "tsx scripts/golden-receipts.ts",
    "merge:sql": "tsx scripts/make-merge-sql.ts",
    "users": "tsx scripts/purchase-users.ts",
    "export:data": "tsx scripts/export-data.ts",
    "check:stock-forms": "tsx --conditions=react-server scripts/check-stock-forms.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.61.0",
    "next": "^15.1.4",
    "next-auth": "5.0.0-beta.32",
    "node": "^27.0.0-alpha.0.1.1",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.89.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
