// ============================================================================
// PHASE II — THE STOCK MODULE'S DOCUMENTS (owner, 21-11-2026; docs/12)
//
// Thiru R's records on the old site: Gate Entry → Purchase Receipt (→ Landed Cost Voucher), the
// Stock Transactions (Material Request, Stock Entry, Delivery Note, Packing Slip), the stock books
// (Stock Ledger Entry, Bin, Stock Reconciliation), Item Price, Serial No, Batch and Quality
// Inspection. The rules of Phase I (docs/02): the ERPNext name is kept (`number`, `code`,
// `erpnextName`), money and quantities are numeric(21,9), the whole source row is in `legacy`, and
// a column exists for what the screens and reports use. Links to the masters (item, warehouse,
// supplier, customer, PO, PO line, price list) are foreign keys BESIDE the ERPNext name, which is
// always kept: a link the backup cannot resolve stays readable and is reported, never guessed.
// Links to records this module has no screen for (accounts, cost centres, templates, addresses,
// letter heads) are the ERPNext names, as the old form showed them.
/// The add-on's "Services Items" on a receipt (services and charges), as the PO has them (its Cost
/// Overheads, Phase I). 566 rows on the old site's receipts.
model PurchaseReceiptServiceItem {
  id             String  @id @default(cuid())
  erpnextName    String  @unique @map("erpnext_name")
  receiptId      String  @map("receipt_id")
  idx            Int
  serviceItem    String? @map("service_item")
  /// A Data field on the old form: text, kept as recorded.
  serviceCharges String? @map("service_charges")
  accountHead    String? @map("account_head")
  chargeType     String? @map("charge_type")
  legacy         Json?

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("purchase_receipt_service_items")
}

/// The add-on's "Sample Item" rows on a packing slip (slab samples).
