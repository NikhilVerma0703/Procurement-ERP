/// Documents of other modules made against a PO — what its Connections tab
/// lists (Purchase Receipt, Purchase Invoice, Material Request, …). Those
/// modules are not replicated; their links and key facts are kept.
model PurchaseOrderLink {
  id        String    @id @default(cuid())
  orderId   String    @map("order_id")
  docType   String    @map("doc_type")
  docName   String    @map("doc_name")
  docDate   DateTime? @map("doc_date") @db.Date
  docStatus String?   @map("doc_status")
  /// Line-level facts from the linked document (e.g. received qty per PO line).
  detail    Json?

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, docType, docName])
  @@index([docType, docName])
  @@map("purchase_order_links")
}

/// A PO's timeline: changes (ERPNext Version), workflow actions and labels,
/// comments and attachment notes (Comment), emails sent (Communication).
/// Deleted drafts are kept too: their last state lives in `data`, with
/// `orderNumber` set and `orderId` empty.
model PurchaseOrderEvent {
  id          String                 @id @default(cuid())
  erpnextName String?                @unique @map("erpnext_name")
  source      String
  orderId     String?                @map("order_id")
  orderNumber String                 @map("order_number")
  kind        PurchaseOrderEventKind
  at          DateTime
  byEmail     String?                @map("by_email")
  subject     String?                @db.Text
  content     String?                @db.Text
  data        Json?

  order PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, at])
  @@index([orderNumber])
  @@map("purchase_order_events")
}

model PurchaseAttachment {
  id          String   @id @default(cuid())
  erpnextName String?  @unique @map("erpnext_name")
  orderId     String?  @map("order_id")
  fileName    String   @map("file_name")
  /// Where the old site served it (/files/… or /private/files/…).
  fileUrl     String   @map("file_url")
  isPrivate   Boolean  @default(false) @map("is_private")
  fileSize    Int?     @map("file_size")
  contentHash String?  @map("content_hash")
  /// Where this system keeps the bytes (relative to its file store).
  storagePath String?  @map("storage_path")
  uploadedBy  String?  @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  order PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("purchase_attachments")
}

/// The module's file store (server/files.ts): the bytes of PO attachments and of the letter-head
/// logo the sheets print, by their place ("files/private/x.pdf", an attachment's storage_path).
/// In the database, as the Main ERP keeps uploaded files: it runs on Vercel, with no lasting disk.
model PurchaseFile {
  path      String   @id
  bytes     Bytes
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("purchase_files")
}

/// Likes: the ♥ on a list row and in a form's sidebar (Frappe's _liked_by, which ERPNext kept on
/// each record): who liked which PO or master, by doctype ("Purchase Order", "Supplier", …) and
/// the record's id. Brought back by the owner's decision of 19-11-2026.
model PurchaseLike {
  id       String   @id @default(cuid())
  doctype  String
  recordId String   @map("record_id")
  email    String
  likedAt  DateTime @default(now()) @map("liked_at")

  @@unique([doctype, recordId, email])
  @@index([email])
  @@map("purchase_likes")
}

