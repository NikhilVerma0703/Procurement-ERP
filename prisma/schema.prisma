// ============================================================================
// Procurement ERP — Prisma schema.
//
// Local development runs against a PostgreSQL database on this machine;
// production will be the Main ERP's Neon database once the module is merged.
// DATABASE_URL is the connection the app uses, DIRECT_URL the unpooled one
// Prisma Migrate needs. Schema changes go through `prisma migrate dev` locally
// (as in the standalone Pigment ERP); at the merge they become one numbered
// SQL script for Neon (as Pigment's scripts/0146).
//
// NAMING, so the merge is a move and not a rename: every model of the module
// is `Purchase*`, every table `purchase_*`, every enum type `purchase_*` (the
// Main ERP's Pigment*/pigment_* rule). Columns are snake_case (@map).
//
// THE MODEL is the old ERPNext site's Buying → Purchase Order and everything
// it points at, table for table (docs/02-data-model.md has the mapping):
//   * every field the PO form shows, or its calculations, statuses and
//     printouts use, is a typed column;
//   * every migrated record also keeps its complete original row in `legacy`
//     (JSON), so nothing in the backup is lost even where no column holds it;
//   * the ERPNext identity is kept: a PO's `number` is its original name
//     (PUR-ORD/25-26/02510), masters keep theirs in `code`, child rows in
//     `erpnext_name` — the importer is re-runnable on a later backup;
//   * relations ERPNext held as links by name are real foreign keys here.
// Money, quantities and rates are numeric(21,9), exactly as ERPNext stores
// them. Timestamps are UTC (the old site's were naive Asia/Kolkata times;
// the importer converts them). Enum values are stored with ERPNext's labels.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — the closed lists of the PO screen, stored as ERPNext's own labels.
// ---------------------------------------------------------------------------

/// ERPNext docstatus: 0 draft, 1 submitted, 2 cancelled.
enum PurchaseDocStatus {
  DRAFT     @map("Draft")
  SUBMITTED @map("Submitted")
  CANCELLED @map("Cancelled")

  @@map("purchase_doc_status")
}

/// The PO approval workflow ("Purchase Order" workflow of the old site).
enum PurchaseWorkflowState {
  CREATED  @map("Created")
  APPROVED @map("Approved")
  REJECTED @map("Rejected")

  @@map("purchase_workflow_state")
}

/// ERPNext 14 Purchase Order status.
enum PurchaseOrderStatus {
  DRAFT               @map("Draft")
  ON_HOLD             @map("On Hold")
  TO_RECEIVE_AND_BILL @map("To Receive and Bill")
  TO_BILL             @map("To Bill")
  TO_RECEIVE          @map("To Receive")
  COMPLETED           @map("Completed")
  CANCELLED           @map("Cancelled")
  CLOSED              @map("Closed")
  DELIVERED           @map("Delivered")

  @@map("purchase_order_status")
}

/// "Apply Additional Discount On".
enum PurchaseApplyDiscountOn {
  GRAND_TOTAL @map("Grand Total")
  NET_TOTAL   @map("Net Total")

  @@map("purchase_apply_discount_on")
}

/// Taxes and charges row "Type".
enum PurchaseTaxChargeType {
  ACTUAL                 @map("Actual")
  ON_NET_TOTAL           @map("On Net Total")
  ON_PREVIOUS_ROW_AMOUNT @map("On Previous Row Amount")
  ON_PREVIOUS_ROW_TOTAL  @map("On Previous Row Total")
  ON_ITEM_QUANTITY       @map("On Item Quantity")

  @@map("purchase_tax_charge_type")
}

/// Taxes and charges row "Consider Tax or Charge for".
enum PurchaseTaxConsiderFor {
  TOTAL               @map("Total")
  VALUATION           @map("Valuation")
  VALUATION_AND_TOTAL @map("Valuation and Total")

  @@map("purchase_tax_consider_for")
}

/// Taxes and charges row "Add or Deduct".
enum PurchaseTaxAddDeduct {
  ADD    @map("Add")
  DEDUCT @map("Deduct")

  @@map("purchase_tax_add_deduct")
}

/// Item row "Margin Type".
enum PurchaseMarginType {
  PERCENTAGE @map("Percentage")
  AMOUNT     @map("Amount")

  @@map("purchase_margin_type")
}

/// What a timeline entry of a PO is (ERPNext Version / Comment / Communication).
enum PurchaseOrderEventKind {
  VERSION    @map("Version")
  WORKFLOW   @map("Workflow")
  LABEL      @map("Label")
  COMMENT    @map("Comment")
  ATTACHMENT @map("Attachment")
  EMAIL      @map("Email")
  DELETED    @map("Deleted")
  INFO       @map("Info")

  @@map("purchase_order_event_kind")
}

// ---------------------------------------------------------------------------
// Company, currencies, units and accounting lookups
// ---------------------------------------------------------------------------

model PurchaseCompany {
  id              String   @id @default(cuid())
  /// ERPNext Company name, e.g. "Pacific Engineered Surfaces Private Limited".
  code            String   @unique
  abbr            String
  country         String?
  defaultCurrency String?  @map("default_currency")
  taxId           String?  @map("tax_id")
  legacy          Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders       PurchaseOrder[]
  accounts     PurchaseAccount[]
  costCenters  PurchaseCostCenter[]
  warehouses   PurchaseWarehouse[]
  taxTemplates PurchaseTaxTemplate[]
  itemTaxTpls  PurchaseItemTaxTemplate[]
  itemDefaults PurchaseItemDefault[]
  addressLinks PurchaseAddressLink[]
  contactLinks PurchaseContactLink[]

  @@map("purchase_companies")
}

model PurchaseCurrency {
  /// ISO code, e.g. INR, USD, EUR — the key POs refer to.
  code                          String   @id
  symbol                        String?
  fraction                      String?
  fractionUnits                 Int?     @map("fraction_units")
  smallestCurrencyFractionValue Decimal? @map("smallest_currency_fraction_value") @db.Decimal(21, 9)
  numberFormat                  String?  @map("number_format")
  enabled                       Boolean  @default(true)

  orders       PurchaseOrder[]            @relation("OrderCurrency")
  priceLists   PurchasePriceList[]
  exchangeFrom PurchaseCurrencyExchange[] @relation("ExchangeFrom")
  exchangeTo   PurchaseCurrencyExchange[] @relation("ExchangeTo")

  @@map("purchase_currencies")
}

model PurchaseCurrencyExchange {
  id           String   @id @default(cuid())
  code         String   @unique
  date         DateTime @db.Date
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  exchangeRate Decimal  @map("exchange_rate") @db.Decimal(21, 9)
  forBuying    Boolean  @default(true) @map("for_buying")
  forSelling   Boolean  @default(true) @map("for_selling")

  from PurchaseCurrency @relation("ExchangeFrom", fields: [fromCurrency], references: [code])
  to   PurchaseCurrency @relation("ExchangeTo", fields: [toCurrency], references: [code])

  @@map("purchase_currency_exchanges")
}

model PurchaseUom {
  /// ERPNext UOM name, e.g. "Nos", "Tonne", "CFT" — the key rows refer to.
  name              String  @id
  mustBeWholeNumber Boolean @default(false) @map("must_be_whole_number")
  enabled           Boolean @default(true)

  itemsStock      PurchaseItem[]              @relation("ItemStockUom")
  itemsPurchase   PurchaseItem[]              @relation("ItemPurchaseUom")
  conversions     PurchaseItemUomConversion[]
  orderItemsUom   PurchaseOrderItem[]         @relation("OrderItemUom")
  orderItemsStock PurchaseOrderItem[]         @relation("OrderItemStockUom")

  @@map("purchase_uoms")
}

model PurchasePriceList {
  id       String  @id @default(cuid())
  code     String  @unique
  currency String
  buying   Boolean @default(false)
  selling  Boolean @default(false)
  enabled  Boolean @default(true)
  legacy   Json?

  currencyRef PurchaseCurrency   @relation(fields: [currency], references: [code])
  orders      PurchaseOrder[]
  suppliers   PurchaseSupplier[]

  // Phase II.
  itemPrices PurchaseItemPrice[]

  @@map("purchase_price_lists")
}

model PurchaseTaxCategory {
  id       String  @id @default(cuid())
  /// "In-State", "Out-State", … (ERPNext Tax Category name).
  code     String  @unique
  title    String?
  disabled Boolean @default(false)

  orders       PurchaseOrder[]
  suppliers    PurchaseSupplier[]
  taxTemplates PurchaseTaxTemplate[]
  itemTaxes    PurchaseItemTax[]

  @@map("purchase_tax_categories")
}

model PurchaseAccount {
  id              String  @id @default(cuid())
  /// ERPNext Account name, e.g. "Input Tax IGST - PESPL".
  code            String  @unique
  accountName     String  @map("account_name")
  accountNumber   String? @map("account_number")
  parentCode      String? @map("parent_code")
  rootType        String? @map("root_type")
  accountType     String? @map("account_type")
  isGroup         Boolean @default(false) @map("is_group")
  accountCurrency String? @map("account_currency")
  disabled        Boolean @default(false)
  companyId       String? @map("company_id")
  legacy          Json?

  company           PurchaseCompany?              @relation(fields: [companyId], references: [id])
  orderTaxes        PurchaseOrderTax[]
  orderItemsExpense PurchaseOrderItem[]
  costOverheads     PurchaseOrderCostOverhead[]
  taxTemplateRows   PurchaseTaxTemplateRow[]
  itemTaxRates      PurchaseItemTaxTemplateRate[]
  itemDefaults      PurchaseItemDefault[]

  @@map("purchase_accounts")
}

model PurchaseCostCenter {
  id             String  @id @default(cuid())
  code           String  @unique
  costCenterName String  @map("cost_center_name")
  parentCode     String? @map("parent_code")
  isGroup        Boolean @default(false) @map("is_group")
  disabled       Boolean @default(false)
  companyId      String? @map("company_id")
  legacy         Json?

  company      PurchaseCompany?      @relation(fields: [companyId], references: [id])
  orders       PurchaseOrder[]
  orderItems   PurchaseOrderItem[]
  orderTaxes   PurchaseOrderTax[]
  itemDefaults PurchaseItemDefault[]

  @@map("purchase_cost_centers")
}

model PurchaseWarehouse {
  id            String  @id @default(cuid())
  code          String  @unique
  warehouseName String  @map("warehouse_name")
  parentCode    String? @map("parent_code")
  isGroup       Boolean @default(false) @map("is_group")
  disabled      Boolean @default(false)
  companyId     String? @map("company_id")
  legacy        Json?

  company      PurchaseCompany?      @relation(fields: [companyId], references: [id])
  ordersTarget PurchaseOrder[]
  orderItems   PurchaseOrderItem[]
  itemDefaults PurchaseItemDefault[]

  // Phase II: the stock documents that point at a warehouse.
  receiptItems             PurchaseReceiptItem[]
  materialRequestItems     PurchaseMaterialRequestItem[]
  stockEntrySources        PurchaseStockEntryDetail[]        @relation("StockEntrySource")
  stockEntryTargets        PurchaseStockEntryDetail[]        @relation("StockEntryTarget")
  stockReconciliationItems PurchaseStockReconciliationItem[]
  deliveryNoteItems        PurchaseDeliveryNoteItem[]
  stockLedgerEntries       PurchaseStockLedgerEntry[]
  bins                     PurchaseBin[]
  serialNos                PurchaseSerialNo[]

  @@map("purchase_warehouses")
}

model PurchaseLetterHead {
  id        String  @id @default(cuid())
  code      String  @unique
  source    String?
  /// Uploaded image path of the original site, e.g. /files/pacific_logo.png.
  image     String?
  content   String? @db.Text
  footer    String? @db.Text
  isDefault Boolean @default(false) @map("is_default")
  disabled  Boolean @default(false)

  orders PurchaseOrder[]

  @@map("purchase_letter_heads")
}

/// The PO numbering series and how far each has counted (ERPNext tabSeries).
model PurchaseNamingSeries {
  /// e.g. "PUR-ORD/25-26/" — the number is the prefix + current, zero-padded to 5.
  prefix  String @id
  current Int    @default(0)

  @@map("purchase_naming_series")
}

// ---------------------------------------------------------------------------
// Templates the PO form fills itself from
// ---------------------------------------------------------------------------

model PurchaseTaxTemplate {
  id            String   @id @default(cuid())
  /// e.g. "Input GST In-state - PESPL".
  code          String   @unique
  title         String
  isDefault     Boolean  @default(false) @map("is_default")
  disabled      Boolean  @default(false)
  companyId     String?  @map("company_id")
  taxCategoryId String?  @map("tax_category_id")
  legacy        Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  company     PurchaseCompany?         @relation(fields: [companyId], references: [id])
  taxCategory PurchaseTaxCategory?     @relation(fields: [taxCategoryId], references: [id])
  rows        PurchaseTaxTemplateRow[]
  orders      PurchaseOrder[]

  @@map("purchase_tax_templates")
}

model PurchaseTaxTemplateRow {
  id                  String                 @id @default(cuid())
  erpnextName         String?                @unique @map("erpnext_name")
  templateId          String                 @map("template_id")
  idx                 Int
  category            PurchaseTaxConsiderFor @default(TOTAL)
  addDeductTax        PurchaseTaxAddDeduct   @default(ADD) @map("add_deduct_tax")
  chargeType          PurchaseTaxChargeType  @map("charge_type")
  rowId               Int?                   @map("row_id")
  accountHeadId       String                 @map("account_head_id")
  description         String?                @db.Text
  rate                Decimal                @default(0) @db.Decimal(21, 9)
  taxAmount           Decimal                @default(0) @map("tax_amount") @db.Decimal(21, 9)
  includedInPrintRate Boolean                @default(false) @map("included_in_print_rate")
  gstTaxType          String?                @map("gst_tax_type")

  template    PurchaseTaxTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accountHead PurchaseAccount     @relation(fields: [accountHeadId], references: [id])

  @@index([templateId])
  @@map("purchase_tax_template_rows")
}

model PurchaseItemTaxTemplate {
  id           String   @id @default(cuid())
  /// e.g. "GST 5% - PESPL".
  code         String   @unique
  title        String
  disabled     Boolean  @default(false)
  gstTreatment String?  @map("gst_treatment")
  gstRate      Decimal? @map("gst_rate") @db.Decimal(21, 9)
  companyId    String?  @map("company_id")
  legacy       Json?

  company    PurchaseCompany?              @relation(fields: [companyId], references: [id])
  rates      PurchaseItemTaxTemplateRate[]
  itemTaxes  PurchaseItemTax[]
  orderItems PurchaseOrderItem[]

  @@map("purchase_item_tax_templates")
}

model PurchaseItemTaxTemplateRate {
  id          String  @id @default(cuid())
  erpnextName String? @unique @map("erpnext_name")
  templateId  String  @map("template_id")
  idx         Int
  /// The tax account the rate applies to (ERPNext "tax_type").
  accountId   String  @map("account_id")
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(21, 9)

  template PurchaseItemTaxTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account  PurchaseAccount         @relation(fields: [accountId], references: [id])

  @@index([templateId])
  @@map("purchase_item_tax_template_rates")
}

model PurchasePaymentTerm {
  id                      String   @id @default(cuid())
  /// e.g. "90 DAYS", "100% Advance".
  code                    String   @unique
  description             String?  @db.Text
  invoicePortion          Decimal? @map("invoice_portion") @db.Decimal(21, 9)
  modeOfPayment           String?  @map("mode_of_payment")
  dueDateBasedOn          String?  @map("due_date_based_on")
  creditDays              Int      @default(0) @map("credit_days")
  creditMonths            Int      @default(0) @map("credit_months")
  discountType            String?  @map("discount_type")
  discount                Decimal? @db.Decimal(21, 9)
  discountValidityBasedOn String?  @map("discount_validity_based_on")
  discountValidity        Int      @default(0) @map("discount_validity")
  legacy                  Json?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  createdBy               String?  @map("created_by")
  updatedBy               String?  @map("updated_by")

  templateRows   PurchasePaymentTermsTemplateRow[]
  orderSchedules PurchaseOrderPaymentSchedule[]

  @@map("purchase_payment_terms")
}

model PurchasePaymentTermsTemplate {
  id                                 String   @id @default(cuid())
  code                               String   @unique
  allocatePaymentBasedOnPaymentTerms Boolean  @default(false) @map("allocate_payment_based_on_payment_terms")
  legacy                             Json?
  createdAt                          DateTime @default(now()) @map("created_at")
  updatedAt                          DateTime @updatedAt @map("updated_at")
  createdBy                          String?  @map("created_by")
  updatedBy                          String?  @map("updated_by")

  rows      PurchasePaymentTermsTemplateRow[]
  orders    PurchaseOrder[]
  suppliers PurchaseSupplier[]

  @@map("purchase_payment_terms_templates")
}

model PurchasePaymentTermsTemplateRow {
  id                      String   @id @default(cuid())
  erpnextName             String?  @unique @map("erpnext_name")
  templateId              String   @map("template_id")
  idx                     Int
  /// The payment term's name as written on the row; paymentTermId when that
  /// name is a Payment Term record (some rows name terms later renamed).
  paymentTermName         String?  @map("payment_term_name")
  paymentTermId           String?  @map("payment_term_id")
  description             String?  @db.Text
  invoicePortion          Decimal  @default(0) @map("invoice_portion") @db.Decimal(21, 9)
  modeOfPayment           String?  @map("mode_of_payment")
  dueDateBasedOn          String?  @map("due_date_based_on")
  creditDays              Int      @default(0) @map("credit_days")
  creditMonths            Int      @default(0) @map("credit_months")
  discountType            String?  @map("discount_type")
  discount                Decimal? @db.Decimal(21, 9)
  discountValidityBasedOn String?  @map("discount_validity_based_on")
  discountValidity        Int      @default(0) @map("discount_validity")

  template    PurchasePaymentTermsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  paymentTerm PurchasePaymentTerm?         @relation(fields: [paymentTermId], references: [id])

  @@index([templateId])
  @@map("purchase_payment_terms_template_rows")
}

/// "Terms" (ERPNext Terms and Conditions) — used as the PO's delivery term.
model PurchaseTermsTemplate {
  id        String   @id @default(cuid())
  /// e.g. "2 WEEKS", "10-15 Days".
  code      String   @unique
  title     String
  terms     String?  @db.Text
  disabled  Boolean  @default(false)
  buying    Boolean  @default(true)
  selling   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  orders PurchaseOrder[]

  @@map("purchase_terms_templates")
}

// ---------------------------------------------------------------------------
// Suppliers, customers, addresses and contacts
// ---------------------------------------------------------------------------

model PurchaseSupplierGroup {
  id         String  @id @default(cuid())
  code       String  @unique
  parentCode String? @map("parent_code")
  isGroup    Boolean @default(false) @map("is_group")

  suppliers PurchaseSupplier[]

  @@map("purchase_supplier_groups")
}

model PurchaseSupplier {
  id                     String    @id @default(cuid())
  /// ERPNext Supplier name (its ID) — what POs referred to.
  code                   String    @unique
  supplierName           String    @map("supplier_name")
  namingSeries           String?   @map("naming_series")
  supplierGroupId        String?   @map("supplier_group_id")
  supplierType           String?   @map("supplier_type")
  country                String?
  defaultCurrency        String?   @map("default_currency")
  defaultPriceListId     String?   @map("default_price_list_id")
  paymentTermsTemplateId String?   @map("payment_terms_template_id")
  language               String?
  taxId                  String?   @map("tax_id")
  taxCategoryId          String?   @map("tax_category_id")
  taxWithholdingCategory String?   @map("tax_withholding_category")
  primaryContactId       String?   @map("primary_contact_id")
  mobileNo               String?   @map("mobile_no")
  emailId                String?   @map("email_id")
  primaryAddressId       String?   @map("primary_address_id")
  primaryAddress         String?   @map("primary_address") @db.Text
  pan                    String?
  gstin                  String?
  gstCategory            String?   @map("gst_category")
  isTransporter          Boolean   @default(false) @map("is_transporter")
  isInternalSupplier     Boolean   @default(false) @map("is_internal_supplier")
  isFrozen               Boolean   @default(false) @map("is_frozen")
  disabled               Boolean   @default(false)
  onHold                 Boolean   @default(false) @map("on_hold")
  holdType               String?   @map("hold_type")
  releaseDate            DateTime? @map("release_date") @db.Date
  warnPos                Boolean   @default(false) @map("warn_pos")
  preventPos             Boolean   @default(false) @map("prevent_pos")
  legacy                 Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String?   @map("created_by")
  updatedBy              String?   @map("updated_by")

  supplierGroup        PurchaseSupplierGroup?        @relation(fields: [supplierGroupId], references: [id])
  defaultPriceList     PurchasePriceList?            @relation(fields: [defaultPriceListId], references: [id])
  paymentTermsTemplate PurchasePaymentTermsTemplate? @relation(fields: [paymentTermsTemplateId], references: [id])
  taxCategory          PurchaseTaxCategory?          @relation(fields: [taxCategoryId], references: [id])
  primaryContact       PurchaseContact?              @relation("SupplierPrimaryContact", fields: [primaryContactId], references: [id])
  primaryAddressRef    PurchaseAddress?              @relation("SupplierPrimaryAddress", fields: [primaryAddressId], references: [id])
  orders               PurchaseOrder[]
  addressLinks         PurchaseAddressLink[]
  contactLinks         PurchaseContactLink[]

  // Phase II.
  gateEntries       PurchaseGateEntry[]
  receipts          PurchaseReceipt[]
  stockEntryDetails PurchaseStockEntryDetail[]
  itemPrices        PurchaseItemPrice[]

  @@index([supplierName])
  @@map("purchase_suppliers")
}

/// Customers appear on a PO only as the Drop Ship customer.
model PurchaseCustomer {
  id            String  @id @default(cuid())
  code          String  @unique
  customerName  String  @map("customer_name")
  customerType  String? @map("customer_type")
  customerGroup String? @map("customer_group")
  territory     String?
  gstin         String?
  disabled      Boolean @default(false)
  legacy        Json?

  orders       PurchaseOrder[]
  addressLinks PurchaseAddressLink[]
  contactLinks PurchaseContactLink[]

  // Phase II.
  deliveryNotes PurchaseDeliveryNote[]

  @@map("purchase_customers")
}

model PurchaseAddress {
  id                   String   @id @default(cuid())
  /// ERPNext Address name, e.g. "Jyoti Timbers-Billing-1".
  code                 String   @unique
  addressTitle         String?  @map("address_title")
  addressType          String?  @map("address_type")
  addressLine1         String   @map("address_line1")
  addressLine2         String?  @map("address_line2")
  city                 String
  county               String?
  state                String?
  country              String
  pincode              String?
  emailId              String?  @map("email_id")
  phone                String?
  fax                  String?
  isPrimaryAddress     Boolean  @default(false) @map("is_primary_address")
  isShippingAddress    Boolean  @default(false) @map("is_shipping_address")
  isYourCompanyAddress Boolean  @default(false) @map("is_your_company_address")
  disabled             Boolean  @default(false)
  taxCategory          String?  @map("tax_category")
  gstin                String?
  gstState             String?  @map("gst_state")
  gstStateNumber       String?  @map("gst_state_number")
  gstCategory          String?  @map("gst_category")
  legacy               Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdBy            String?  @map("created_by")
  updatedBy            String?  @map("updated_by")

  links            PurchaseAddressLink[]
  suppliersPrimary PurchaseSupplier[]    @relation("SupplierPrimaryAddress")
  ordersSupplier   PurchaseOrder[]       @relation("OrderSupplierAddress")
  ordersShipping   PurchaseOrder[]       @relation("OrderShippingAddress")
  ordersBilling    PurchaseOrder[]       @relation("OrderBillingAddress")

  @@map("purchase_addresses")
}

/// Who an address belongs to (ERPNext Dynamic Link): a supplier, a customer
/// or the company. The original link is kept as text, resolved to a FK.
model PurchaseAddressLink {
  id          String  @id @default(cuid())
  erpnextName String? @unique @map("erpnext_name")
  addressId   String  @map("address_id")
  idx         Int     @default(1)
  linkDoctype String  @map("link_doctype")
  linkName    String  @map("link_name")
  linkTitle   String? @map("link_title")
  supplierId  String? @map("supplier_id")
  customerId  String? @map("customer_id")
  companyId   String? @map("company_id")

  address  PurchaseAddress   @relation(fields: [addressId], references: [id], onDelete: Cascade)
  supplier PurchaseSupplier? @relation(fields: [supplierId], references: [id])
  customer PurchaseCustomer? @relation(fields: [customerId], references: [id])
  company  PurchaseCompany?  @relation(fields: [companyId], references: [id])

  @@index([addressId])
  @@index([supplierId])
  @@map("purchase_address_links")
}

model PurchaseContact {
  id               String   @id @default(cuid())
  code             String   @unique
  salutation       String?
  firstName        String   @map("first_name")
  middleName       String?  @map("middle_name")
  lastName         String?  @map("last_name")
  designation      String?
  gender           String?
  emailId          String?  @map("email_id")
  phone            String?
  mobileNo         String?  @map("mobile_no")
  companyName      String?  @map("company_name")
  status           String?
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  isBillingContact Boolean  @default(false) @map("is_billing_contact")
  userEmail        String?  @map("user_email")
  legacy           Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")

  emails            PurchaseContactEmail[]
  phones            PurchaseContactPhone[]
  links             PurchaseContactLink[]
  suppliersPrimary  PurchaseSupplier[]     @relation("SupplierPrimaryContact")
  ordersContact     PurchaseOrder[]        @relation("OrderContactPerson")
  ordersCustContact PurchaseOrder[]        @relation("OrderCustomerContactPerson")

  @@map("purchase_contacts")
}

model PurchaseContactEmail {
  id          String  @id @default(cuid())
  erpnextName String? @unique @map("erpnext_name")
  contactId   String  @map("contact_id")
  idx         Int     @default(1)
  emailId     String  @map("email_id")
  isPrimary   Boolean @default(false) @map("is_primary")

  contact PurchaseContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("purchase_contact_emails")
}

model PurchaseContactPhone {
  id                String  @id @default(cuid())
  erpnextName       String? @unique @map("erpnext_name")
  contactId         String  @map("contact_id")
  idx               Int     @default(1)
  phone             String
  isPrimaryPhone    Boolean @default(false) @map("is_primary_phone")
  isPrimaryMobileNo Boolean @default(false) @map("is_primary_mobile_no")

  contact PurchaseContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("purchase_contact_phones")
}

/// Who a contact belongs to (ERPNext Dynamic Link), as for addresses.
model PurchaseContactLink {
  id          String  @id @default(cuid())
  erpnextName String? @unique @map("erpnext_name")
  contactId   String  @map("contact_id")
  idx         Int     @default(1)
  linkDoctype String  @map("link_doctype")
  linkName    String  @map("link_name")
  linkTitle   String? @map("link_title")
  supplierId  String? @map("supplier_id")
  customerId  String? @map("customer_id")
  companyId   String? @map("company_id")

  contact  PurchaseContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  supplier PurchaseSupplier? @relation(fields: [supplierId], references: [id])
  customer PurchaseCustomer? @relation(fields: [customerId], references: [id])
  company  PurchaseCompany?  @relation(fields: [companyId], references: [id])

  @@index([contactId])
  @@index([supplierId])
  @@map("purchase_contact_links")
}

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

model PurchaseItemGroup {
  id         String  @id @default(cuid())
  code       String  @unique
  parentCode String? @map("parent_code")
  isGroup    Boolean @default(false) @map("is_group")

  items PurchaseItem[]

  @@map("purchase_item_groups")
}

model PurchaseItem {
  id                 String    @id @default(cuid())
  /// ERPNext item_code (= its name) — what PO lines referred to.
  code               String    @unique
  itemName           String    @map("item_name")
  itemGroupId        String?   @map("item_group_id")
  stockUom           String    @map("stock_uom")
  purchaseUom        String?   @map("purchase_uom")
  description        String?   @db.Text
  image              String?
  brand              String?
  disabled           Boolean   @default(false)
  isStockItem        Boolean   @default(true) @map("is_stock_item")
  isPurchaseItem     Boolean   @default(true) @map("is_purchase_item")
  isFixedAsset       Boolean   @default(false) @map("is_fixed_asset")
  hasVariants        Boolean   @default(false) @map("has_variants")
  variantOfId        String?   @map("variant_of_id")
  hasBatchNo         Boolean   @default(false) @map("has_batch_no")
  hasSerialNo        Boolean   @default(false) @map("has_serial_no")
  /// Add-on flag: offered in the PO's Cost Overheads table (14 items).
  serviceItem        Boolean   @default(false) @map("service_item")
  gstHsnCode         String?   @map("gst_hsn_code")
  isIneligibleForItc Boolean   @default(false) @map("is_ineligible_for_itc")
  lastPurchaseRate   Decimal   @default(0) @map("last_purchase_rate") @db.Decimal(21, 9)
  standardRate       Decimal   @default(0) @map("standard_rate") @db.Decimal(21, 9)
  valuationRate      Decimal   @default(0) @map("valuation_rate") @db.Decimal(21, 9)
  minOrderQty        Decimal   @default(0) @map("min_order_qty") @db.Decimal(21, 9)
  safetyStock        Decimal   @default(0) @map("safety_stock") @db.Decimal(21, 9)
  leadTimeDays       Int       @default(0) @map("lead_time_days")
  weightPerUnit      Decimal   @default(0) @map("weight_per_unit") @db.Decimal(21, 9)
  weightUom          String?   @map("weight_uom")
  countryOfOrigin    String?   @map("country_of_origin")
  endOfLife          DateTime? @map("end_of_life") @db.Date
  legacy             Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")

  itemGroup      PurchaseItemGroup?             @relation(fields: [itemGroupId], references: [id])
  stockUomRef    PurchaseUom                    @relation("ItemStockUom", fields: [stockUom], references: [name])
  purchaseUomRef PurchaseUom?                   @relation("ItemPurchaseUom", fields: [purchaseUom], references: [name])
  variantOf      PurchaseItem?                  @relation("ItemVariants", fields: [variantOfId], references: [id])
  variants       PurchaseItem[]                 @relation("ItemVariants")
  uomConversions PurchaseItemUomConversion[]
  defaults       PurchaseItemDefault[]
  taxes          PurchaseItemTax[]
  attributes     PurchaseItemVariantAttribute[]
  orderItems     PurchaseOrderItem[]
  costOverheads  PurchaseOrderCostOverhead[]

  // Phase II: the stock documents that point at an item.
  gateEntryItems           PurchaseGateEntryItem[]
  receiptItems             PurchaseReceiptItem[]
  landedCostItems          PurchaseLandedCostItem[]
  materialRequestItems     PurchaseMaterialRequestItem[]
  stockEntryDetails        PurchaseStockEntryDetail[]
  stockReconciliationItems PurchaseStockReconciliationItem[]
  deliveryNoteItems        PurchaseDeliveryNoteItem[]
  packingSlipItems         PurchasePackingSlipItem[]
  stockLedgerEntries       PurchaseStockLedgerEntry[]
  bins                     PurchaseBin[]
  itemPrices               PurchaseItemPrice[]
  serialNos                PurchaseSerialNo[]
  batches                  PurchaseBatch[]
  qualityInspections       PurchaseQualityInspection[]

  @@index([itemName])
  @@map("purchase_items")
}

model PurchaseItemUomConversion {
  id               String  @id @default(cuid())
  erpnextName      String? @unique @map("erpnext_name")
  itemId           String  @map("item_id")
  idx              Int     @default(1)
  uom              String
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(21, 9)

  item   PurchaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uomRef PurchaseUom  @relation(fields: [uom], references: [name])

  @@index([itemId])
  @@map("purchase_item_uom_conversions")
}

/// Per-company item defaults: warehouse, expense account (also the Cost
/// Overhead account of a service item), cost centre, supplier, price list.
model PurchaseItemDefault {
  id                 String  @id @default(cuid())
  erpnextName        String? @unique @map("erpnext_name")
  itemId             String  @map("item_id")
  idx                Int     @default(1)
  companyId          String  @map("company_id")
  defaultWarehouseId String? @map("default_warehouse_id")
  expenseAccountId   String? @map("expense_account_id")
  buyingCostCenterId String? @map("buying_cost_center_id")
  defaultSupplier    String? @map("default_supplier")
  defaultPriceList   String? @map("default_price_list")

  item             PurchaseItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  company          PurchaseCompany     @relation(fields: [companyId], references: [id])
  defaultWarehouse PurchaseWarehouse?  @relation(fields: [defaultWarehouseId], references: [id])
  expenseAccount   PurchaseAccount?    @relation(fields: [expenseAccountId], references: [id])
  buyingCostCenter PurchaseCostCenter? @relation(fields: [buyingCostCenterId], references: [id])

  @@index([itemId])
  @@map("purchase_item_defaults")
}

/// Which Item Tax Template applies to an item, per tax category.
model PurchaseItemTax {
  id                String    @id @default(cuid())
  erpnextName       String?   @unique @map("erpnext_name")
  itemId            String    @map("item_id")
  idx               Int       @default(1)
  itemTaxTemplateId String    @map("item_tax_template_id")
  taxCategoryId     String?   @map("tax_category_id")
  validFrom         DateTime? @map("valid_from") @db.Date
  minimumNetRate    Decimal   @default(0) @map("minimum_net_rate") @db.Decimal(21, 9)
  maximumNetRate    Decimal   @default(0) @map("maximum_net_rate") @db.Decimal(21, 9)

  item            PurchaseItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemTaxTemplate PurchaseItemTaxTemplate @relation(fields: [itemTaxTemplateId], references: [id])
  taxCategory     PurchaseTaxCategory?    @relation(fields: [taxCategoryId], references: [id])

  @@index([itemId])
  @@map("purchase_item_taxes")
}

/// India Compliance's GST HSN Code list: what an Item's HSN/SAC must be one of.
model PurchaseHsnCode {
  code        String  @id
  description String? @db.Text

  @@map("purchase_hsn_codes")
}

/// Item Attribute: what a template's variants differ in (Finish, Thickness, …), with the values
/// it takes and their abbreviations, which make a variant's code and name.
model PurchaseItemAttribute {
  id            String  @id @default(cuid())
  code          String  @unique
  numericValues Boolean @default(false) @map("numeric_values")
  fromRange     Decimal @default(0) @map("from_range") @db.Decimal(21, 9)
  toRange       Decimal @default(0) @map("to_range") @db.Decimal(21, 9)
  increment     Decimal @default(0) @db.Decimal(21, 9)
  legacy        Json?

  values PurchaseItemAttributeValue[]

  @@map("purchase_item_attributes")
}

model PurchaseItemAttributeValue {
  id             String  @id @default(cuid())
  erpnextName    String? @unique @map("erpnext_name")
  attributeId    String  @map("attribute_id")
  idx            Int     @default(1)
  attributeValue String  @map("attribute_value")
  abbr           String

  attribute PurchaseItemAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@map("purchase_item_attribute_values")
}

/// An item's Variant Attributes: on a template, the attributes its variants differ in; on a
/// variant, the value of each. The attribute is kept by name, as ERPNext linked it.
model PurchaseItemVariantAttribute {
  id             String  @id @default(cuid())
  erpnextName    String? @unique @map("erpnext_name")
  itemId         String  @map("item_id")
  idx            Int     @default(1)
  attribute      String
  attributeValue String? @map("attribute_value")
  /// The template's code, on a variant's rows.
  variantOf      String? @map("variant_of")
  numericValues  Boolean @default(false) @map("numeric_values")
  fromRange      Decimal @default(0) @map("from_range") @db.Decimal(21, 9)
  toRange        Decimal @default(0) @map("to_range") @db.Decimal(21, 9)
  increment      Decimal @default(0) @db.Decimal(21, 9)

  item PurchaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("purchase_item_variant_attributes")
}

// ---------------------------------------------------------------------------
// The Purchase Order
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id            String                @id @default(cuid())
  /// The PO number — the original ERPNext name, e.g. "PUR-ORD/25-26/02510";
  /// an amended PO carries a suffix ("PUR-ORD/25-26/02015-1").
  number        String                @unique
  title         String?
  namingSeries  String                @map("naming_series")
  docStatus     PurchaseDocStatus     @default(DRAFT) @map("doc_status")
  workflowState PurchaseWorkflowState @default(CREATED) @map("workflow_state")
  status        PurchaseOrderStatus   @default(DRAFT)
  amendedFromId String?               @map("amended_from_id")

  // Details tab
  supplierId             String    @map("supplier_id")
  supplierName           String    @map("supplier_name")
  orderConfirmationNo    String?   @map("order_confirmation_no")
  orderConfirmationDate  DateTime? @map("order_confirmation_date") @db.Date
  /// The add-on's Select fields are text, as ERPNext stored them: their option
  /// lists changed over time and older POs keep older values ("Air / Ship" on
  /// 16 POs). The form offers today's options (lib/purchase/orders/options.ts).
  shipmentType           String?   @map("shipment_type")
  modeOfTransport        String?   @default("Road") @map("mode_of_transport")
  transactionDate        DateTime  @map("transaction_date") @db.Date
  scheduleDate           DateTime? @map("schedule_date") @db.Date
  purposeOfPurchase      String?   @map("purpose_of_purchase")
  companyId              String    @map("company_id")
  applyTds               Boolean   @default(false) @map("apply_tds")
  taxWithholdingCategory String?   @map("tax_withholding_category")
  isReverseCharge        Boolean   @default(false) @map("is_reverse_charge")
  isSubcontracted        Boolean   @default(false) @map("is_subcontracted")
  supplierWarehouse      String?   @map("supplier_warehouse")
  /// Custom fields once on the form (removed later); 6 POs carry them.
  proformaInvoiceNo      String?   @map("proforma_invoice_no")
  proformaInvoiceDate    DateTime? @map("proforma_invoice_date") @db.Date

  // Accounting dimensions
  costCenterId String? @map("cost_center_id")
  project      String?

  // Currency and price list
  currency          String
  conversionRate    Decimal @default(1) @map("conversion_rate") @db.Decimal(21, 9)
  buyingPriceListId String? @map("buying_price_list_id")
  priceListCurrency String? @map("price_list_currency")
  plcConversionRate Decimal @default(1) @map("plc_conversion_rate") @db.Decimal(21, 9)
  ignorePricingRule Boolean @default(false) @map("ignore_pricing_rule")

  // Items section
  setFromWarehouse           String? @map("set_from_warehouse")
  setWarehouseId             String? @map("set_warehouse_id")
  setReserveWarehouse        String? @map("set_reserve_warehouse")
  totalQty                   Decimal @default(0) @map("total_qty") @db.Decimal(21, 9)
  totalNetWeight             Decimal @default(0) @map("total_net_weight") @db.Decimal(21, 9)
  baseTotal                  Decimal @default(0) @map("base_total") @db.Decimal(21, 9)
  baseNetTotal               Decimal @default(0) @map("base_net_total") @db.Decimal(21, 9)
  total                      Decimal @default(0) @db.Decimal(21, 9)
  netTotal                   Decimal @default(0) @map("net_total") @db.Decimal(21, 9)
  taxWithholdingNetTotal     Decimal @default(0) @map("tax_withholding_net_total") @db.Decimal(21, 9)
  baseTaxWithholdingNetTotal Decimal @default(0) @map("base_tax_withholding_net_total") @db.Decimal(21, 9)

  // Taxes and charges
  taxCategoryId               String? @map("tax_category_id")
  taxesAndChargesId           String? @map("taxes_and_charges_id")
  shippingRule                String? @map("shipping_rule")
  incoterm                    String?
  namedPlace                  String? @map("named_place")
  baseTaxesAndChargesAdded    Decimal @default(0) @map("base_taxes_and_charges_added") @db.Decimal(21, 9)
  baseTaxesAndChargesDeducted Decimal @default(0) @map("base_taxes_and_charges_deducted") @db.Decimal(21, 9)
  baseTotalTaxesAndCharges    Decimal @default(0) @map("base_total_taxes_and_charges") @db.Decimal(21, 9)
  taxesAndChargesAdded        Decimal @default(0) @map("taxes_and_charges_added") @db.Decimal(21, 9)
  taxesAndChargesDeducted     Decimal @default(0) @map("taxes_and_charges_deducted") @db.Decimal(21, 9)
  totalTaxesAndCharges        Decimal @default(0) @map("total_taxes_and_charges") @db.Decimal(21, 9)

  // Totals
  baseGrandTotal         Decimal @default(0) @map("base_grand_total") @db.Decimal(21, 9)
  baseRoundingAdjustment Decimal @default(0) @map("base_rounding_adjustment") @db.Decimal(21, 9)
  baseRoundedTotal       Decimal @default(0) @map("base_rounded_total") @db.Decimal(21, 9)
  baseInWords            String? @map("base_in_words")
  grandTotal             Decimal @default(0) @map("grand_total") @db.Decimal(21, 9)
  roundingAdjustment     Decimal @default(0) @map("rounding_adjustment") @db.Decimal(21, 9)
  roundedTotal           Decimal @default(0) @map("rounded_total") @db.Decimal(21, 9)
  disableRoundedTotal    Boolean @default(false) @map("disable_rounded_total")
  inWords                String? @map("in_words")
  advancePaid            Decimal @default(0) @map("advance_paid") @db.Decimal(21, 9)

  // Additional discount
  applyDiscountOn              PurchaseApplyDiscountOn @default(GRAND_TOTAL) @map("apply_discount_on")
  baseDiscountAmount           Decimal                 @default(0) @map("base_discount_amount") @db.Decimal(21, 9)
  additionalDiscountPercentage Decimal                 @default(0) @map("additional_discount_percentage") @db.Decimal(21, 9)
  discountAmount               Decimal                 @default(0) @map("discount_amount") @db.Decimal(21, 9)

  // Tax breakup / GST breakup (rendered tables, as ERPNext stored them)
  otherChargesCalculation String? @map("other_charges_calculation") @db.Text
  gstBreakupTable         String? @map("gst_breakup_table") @db.Text

  // Address & Contact tab (links plus the printed text as it was)
  supplierAddressId      String? @map("supplier_address_id")
  addressDisplay         String? @map("address_display") @db.Text
  supplierGstin          String? @map("supplier_gstin")
  gstCategory            String? @map("gst_category")
  contactPersonId        String? @map("contact_person_id")
  contactDisplay         String? @map("contact_display") @db.Text
  contactMobile          String? @map("contact_mobile") @db.Text
  contactEmail           String? @map("contact_email") @db.Text
  shippingAddressId      String? @map("shipping_address_id")
  shippingAddressDisplay String? @map("shipping_address_display") @db.Text
  billingAddressId       String? @map("billing_address_id")
  billingAddressDisplay  String? @map("billing_address_display") @db.Text
  companyGstin           String? @map("company_gstin")
  placeOfSupply          String? @map("place_of_supply")

  // Drop Ship tab
  customerId              String? @map("customer_id")
  customerName            String? @map("customer_name")
  customerContactPersonId String? @map("customer_contact_person_id")
  customerContactDisplay  String? @map("customer_contact_display") @db.Text
  customerContactMobile   String? @map("customer_contact_mobile") @db.Text
  customerContactEmail    String? @map("customer_contact_email") @db.Text

  // Terms tab
  paymentTermsTemplateId String? @map("payment_terms_template_id")
  termsTemplateId        String? @map("terms_template_id")
  terms                  String? @db.Text

  // More Info tab
  perBilled            Decimal   @default(0) @map("per_billed") @db.Decimal(21, 9)
  perReceived          Decimal   @default(0) @map("per_received") @db.Decimal(21, 9)
  letterHeadId         String?   @map("letter_head_id")
  groupSameItems       Boolean   @default(false) @map("group_same_items")
  selectPrintHeading   String?   @map("select_print_heading")
  language             String?
  fromDate             DateTime? @map("from_date") @db.Date
  toDate               DateTime? @map("to_date") @db.Date
  autoRepeat           String?   @map("auto_repeat")
  isInternalSupplier   Boolean   @default(false) @map("is_internal_supplier")
  representsCompany    String?   @map("represents_company")
  partyAccountCurrency String?   @map("party_account_currency")

  legacy    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  amendedFrom           PurchaseOrder?                 @relation("OrderAmendments", fields: [amendedFromId], references: [id])
  amendments            PurchaseOrder[]                @relation("OrderAmendments")
  supplier              PurchaseSupplier               @relation(fields: [supplierId], references: [id])
  company               PurchaseCompany                @relation(fields: [companyId], references: [id])
  costCenter            PurchaseCostCenter?            @relation(fields: [costCenterId], references: [id])
  currencyRef           PurchaseCurrency               @relation("OrderCurrency", fields: [currency], references: [code])
  buyingPriceList       PurchasePriceList?             @relation(fields: [buyingPriceListId], references: [id])
  setWarehouse          PurchaseWarehouse?             @relation(fields: [setWarehouseId], references: [id])
  taxCategory           PurchaseTaxCategory?           @relation(fields: [taxCategoryId], references: [id])
  taxesAndCharges       PurchaseTaxTemplate?           @relation(fields: [taxesAndChargesId], references: [id])
  supplierAddress       PurchaseAddress?               @relation("OrderSupplierAddress", fields: [supplierAddressId], references: [id])
  contactPerson         PurchaseContact?               @relation("OrderContactPerson", fields: [contactPersonId], references: [id])
  shippingAddress       PurchaseAddress?               @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress        PurchaseAddress?               @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  customer              PurchaseCustomer?              @relation(fields: [customerId], references: [id])
  customerContactPerson PurchaseContact?               @relation("OrderCustomerContactPerson", fields: [customerContactPersonId], references: [id])
  paymentTermsTemplate  PurchasePaymentTermsTemplate?  @relation(fields: [paymentTermsTemplateId], references: [id])
  termsTemplate         PurchaseTermsTemplate?         @relation(fields: [termsTemplateId], references: [id])
  letterHead            PurchaseLetterHead?            @relation(fields: [letterHeadId], references: [id])
  items                 PurchaseOrderItem[]
  taxes                 PurchaseOrderTax[]
  costOverheads         PurchaseOrderCostOverhead[]
  paymentSchedule       PurchaseOrderPaymentSchedule[]
  links                 PurchaseOrderLink[]
  events                PurchaseOrderEvent[]
  attachments           PurchaseAttachment[]

  // Phase II: the gate entries and receipts made against this PO.
  gateEntries    PurchaseGateEntry[]
  gateEntryItems PurchaseGateEntryItem[]
  receiptItems   PurchaseReceiptItem[]

  @@index([supplierId])
  @@index([transactionDate])
  @@index([status])
  @@index([workflowState])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  erpnextName String? @unique @map("erpnext_name")
  orderId     String  @map("order_id")
  idx         Int

  itemId             String  @map("item_id")
  /// Snapshots as on the PO (ERPNext copies them from the Item when chosen).
  itemCode           String  @map("item_code")
  itemName           String  @map("item_name")
  itemGroup          String? @map("item_group")
  description        String? @db.Text
  image              String?
  brand              String?
  supplierPartNo     String? @map("supplier_part_no")
  gstHsnCode         String? @map("gst_hsn_code")
  isIneligibleForItc Boolean @default(false) @map("is_ineligible_for_itc")

  scheduleDate         DateTime? @map("schedule_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  qty              Decimal @db.Decimal(21, 9)
  uom              String
  stockUom         String  @map("stock_uom")
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(21, 9)
  stockQty         Decimal @default(0) @map("stock_qty") @db.Decimal(21, 9)

  priceListRate      Decimal             @default(0) @map("price_list_rate") @db.Decimal(21, 9)
  basePriceListRate  Decimal             @default(0) @map("base_price_list_rate") @db.Decimal(21, 9)
  lastPurchaseRate   Decimal             @default(0) @map("last_purchase_rate") @db.Decimal(21, 9)
  marginType         PurchaseMarginType? @map("margin_type")
  marginRateOrAmount Decimal             @default(0) @map("margin_rate_or_amount") @db.Decimal(21, 9)
  rateWithMargin     Decimal             @default(0) @map("rate_with_margin") @db.Decimal(21, 9)
  baseRateWithMargin Decimal             @default(0) @map("base_rate_with_margin") @db.Decimal(21, 9)
  discountPercentage Decimal             @default(0) @map("discount_percentage") @db.Decimal(21, 9)
  discountAmount     Decimal             @default(0) @map("discount_amount") @db.Decimal(21, 9)
  rate               Decimal             @default(0) @db.Decimal(21, 9)
  /// Shown as "Final Amount" on the original form.
  amount             Decimal             @default(0) @db.Decimal(21, 9)
  baseRate           Decimal             @default(0) @map("base_rate") @db.Decimal(21, 9)
  baseAmount         Decimal             @default(0) @map("base_amount") @db.Decimal(21, 9)
  stockUomRate       Decimal             @default(0) @map("stock_uom_rate") @db.Decimal(21, 9)
  netRate            Decimal             @default(0) @map("net_rate") @db.Decimal(21, 9)
  netAmount          Decimal             @default(0) @map("net_amount") @db.Decimal(21, 9)
  baseNetRate        Decimal             @default(0) @map("base_net_rate") @db.Decimal(21, 9)
  baseNetAmount      Decimal             @default(0) @map("base_net_amount") @db.Decimal(21, 9)
  isFreeItem         Boolean             @default(false) @map("is_free_item")
  pricingRules       String?             @map("pricing_rules") @db.Text

  itemTaxTemplateId String? @map("item_tax_template_id")
  /// ERPNext's per-row tax map {tax account: rate}, as stored.
  itemTaxRate       Json?   @map("item_tax_rate")
  applyTds          Boolean @default(true) @map("apply_tds")

  // India Compliance GST details (computed by ERPNext)
  gstTreatment       String? @map("gst_treatment")
  taxableValue       Decimal @default(0) @map("taxable_value") @db.Decimal(21, 9)
  igstRate           Decimal @default(0) @map("igst_rate") @db.Decimal(21, 9)
  cgstRate           Decimal @default(0) @map("cgst_rate") @db.Decimal(21, 9)
  sgstRate           Decimal @default(0) @map("sgst_rate") @db.Decimal(21, 9)
  cessRate           Decimal @default(0) @map("cess_rate") @db.Decimal(21, 9)
  cessNonAdvolRate   Decimal @default(0) @map("cess_non_advol_rate") @db.Decimal(21, 9)
  igstAmount         Decimal @default(0) @map("igst_amount") @db.Decimal(21, 9)
  cgstAmount         Decimal @default(0) @map("cgst_amount") @db.Decimal(21, 9)
  sgstAmount         Decimal @default(0) @map("sgst_amount") @db.Decimal(21, 9)
  cessAmount         Decimal @default(0) @map("cess_amount") @db.Decimal(21, 9)
  cessNonAdvolAmount Decimal @default(0) @map("cess_non_advol_amount") @db.Decimal(21, 9)

  // The add-on's grid columns (SGST %/Amt, CGST %/Amt, IGST %/Amt) — printed on the PO sheet
  sgst    Decimal @default(0) @db.Decimal(21, 9)
  sgstAmt Decimal @default(0) @map("sgst_amt") @db.Decimal(21, 9)
  cgst    Decimal @default(0) @db.Decimal(21, 9)
  cgstAmt Decimal @default(0) @map("cgst_amt") @db.Decimal(21, 9)
  igst    Decimal @default(0) @db.Decimal(21, 9)
  igstAmt Decimal @default(0) @map("igst_amt") @db.Decimal(21, 9)

  warehouseId       String? @map("warehouse_id")
  fromWarehouse     String? @map("from_warehouse")
  /// Stock at the time the line was entered (ERPNext fills these).
  actualQty         Decimal @default(0) @map("actual_qty") @db.Decimal(21, 9)
  companyTotalStock Decimal @default(0) @map("company_total_stock") @db.Decimal(21, 9)
  expenseAccountId  String? @map("expense_account_id")
  costCenterId      String? @map("cost_center_id")
  project           String?

  /// Source documents, kept as references (those modules are not replicated).
  materialRequest       String? @map("material_request")
  materialRequestItem   String? @map("material_request_item")
  salesOrder            String? @map("sales_order")
  salesOrderItem        String? @map("sales_order_item")
  supplierQuotation     String? @map("supplier_quotation")
  supplierQuotationItem String? @map("supplier_quotation_item")
  deliveredBySupplier   Boolean @default(false) @map("delivered_by_supplier")
  blanketOrder          String? @map("blanket_order")

  // Fulfilment, as recorded by the receipts and invoices against this line
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(21, 9)
  returnedQty Decimal @default(0) @map("returned_qty") @db.Decimal(21, 9)
  billedAmt   Decimal @default(0) @map("billed_amt") @db.Decimal(21, 9)

  manufacturer       String?
  manufacturerPartNo String? @map("manufacturer_part_no")
  bom                String?
  weightPerUnit      Decimal @default(0) @map("weight_per_unit") @db.Decimal(21, 9)
  totalWeight        Decimal @default(0) @map("total_weight") @db.Decimal(21, 9)
  weightUom          String? @map("weight_uom")
  isFixedAsset       Boolean @default(false) @map("is_fixed_asset")
  pageBreak          Boolean @default(false) @map("page_break")

  legacy Json?

  order           PurchaseOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            PurchaseItem             @relation(fields: [itemId], references: [id])
  uomRef          PurchaseUom              @relation("OrderItemUom", fields: [uom], references: [name])
  stockUomRef     PurchaseUom              @relation("OrderItemStockUom", fields: [stockUom], references: [name])
  itemTaxTemplate PurchaseItemTaxTemplate? @relation(fields: [itemTaxTemplateId], references: [id])
  warehouse       PurchaseWarehouse?       @relation(fields: [warehouseId], references: [id])
  expenseAccount  PurchaseAccount?         @relation(fields: [expenseAccountId], references: [id])
  costCenter      PurchaseCostCenter?      @relation(fields: [costCenterId], references: [id])

  // Phase II.
  gateEntryItems PurchaseGateEntryItem[]
  receiptItems   PurchaseReceiptItem[]

  @@index([orderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

