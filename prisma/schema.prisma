/// The add-on's Gate Entry: a vehicle at the gate against one PO (docs/12 §4). Imported as recorded;
/// its screen waits for the owner's description of the workflow.
model PurchaseGateEntry {
  id            String            @id @default(cuid())
  /// ERPNext name, e.g. "GE-25-26-03510".
  number        String            @unique
  namingSeries  String            @map("naming_series")
  docStatus     PurchaseDocStatus @default(DRAFT) @map("doc_status")
  amendedFromId String?           @map("amended_from_id")
  location      String?
  orderNumber   String            @map("order_number")
  orderId       String?           @map("order_id")
  orderDate     DateTime?         @map("order_date") @db.Date
  supplierCode  String            @map("supplier_code")
  supplierId    String?           @map("supplier_id")
  invoiceNo     String?           @map("invoice_no")
  invoiceDate   DateTime?         @map("invoice_date") @db.Date
  gateEntryDate DateTime?         @map("gate_entry_date") @db.Date
  /// "Inward No": the Purchase Receipt raised from this gate entry.
  receiptNumber String?           @map("receipt_number")
  inwardDate    DateTime?         @map("inward_date") @db.Date
  financialYear String?           @map("financial_year")
  vehicleNo     String?           @map("vehicle_no")
  legacy        Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  createdBy     String?           @map("created_by")
  updatedBy     String?           @map("updated_by")

  amendedFrom PurchaseGateEntry?      @relation("GateEntryAmendments", fields: [amendedFromId], references: [id])
  amendments  PurchaseGateEntry[]     @relation("GateEntryAmendments")
  order       PurchaseOrder?          @relation(fields: [orderId], references: [id])
  supplier    PurchaseSupplier?       @relation(fields: [supplierId], references: [id])
  items       PurchaseGateEntryItem[]
  receipts    PurchaseReceipt[]

  @@index([orderId])
  @@index([supplierId])
  @@index([gateEntryDate])
  @@map("purchase_gate_entries")
}

model PurchaseGateEntryItem {
  id              String    @id @default(cuid())
  erpnextName     String    @unique @map("erpnext_name")
  gateEntryId     String    @map("gate_entry_id")
  idx             Int
  orderNumber     String?   @map("order_number")
