/// The stock ledger: one row per item per warehouse per stock movement, as ERPNext wrote it (FIFO).
model PurchaseStockLedgerEntry {
  id                          String            @id @default(cuid())
  erpnextName                 String            @unique @map("erpnext_name")
  itemCode                    String            @map("item_code")
  itemId                      String?           @map("item_id")
  warehouseCode               String            @map("warehouse_code")
  warehouseId                 String?           @map("warehouse_id")
  postingDate                 DateTime          @map("posting_date") @db.Date
  postingTime                 String            @map("posting_time")
  /// The posting date and time as one instant (the old site's wall clock, Asia/Kolkata, in UTC).
  postingDateTime             DateTime          @map("posting_date_time")
  voucherType                 String            @map("voucher_type")
  voucherNo                   String            @map("voucher_no")
  voucherDetailNo             String?           @map("voucher_detail_no")
  dependantSleVoucherDetailNo String?           @map("dependant_sle_voucher_detail_no")
  recalculateRate             Boolean           @default(false) @map("recalculate_rate")
  actualQty                   Decimal           @default(0) @map("actual_qty") @db.Decimal(21, 9)
  qtyAfterTransaction         Decimal           @default(0) @map("qty_after_transaction") @db.Decimal(21, 9)
  incomingRate                Decimal           @default(0) @map("incoming_rate") @db.Decimal(21, 9)
  outgoingRate                Decimal           @default(0) @map("outgoing_rate") @db.Decimal(21, 9)
  valuationRate               Decimal           @default(0) @map("valuation_rate") @db.Decimal(21, 9)
  stockValue                  Decimal           @default(0) @map("stock_value") @db.Decimal(21, 9)
  stockValueDifference        Decimal           @default(0) @map("stock_value_difference") @db.Decimal(21, 9)
  /// The FIFO queue after this entry, [[qty, rate], …], as ERPNext stored it (JSON text).
  stockQueue                  String?           @map("stock_queue")
  companyCode                 String            @map("company_code")
  stockUom                    String?           @map("stock_uom")
  batchNo                     String?           @map("batch_no")
  serialNo                    String?           @map("serial_no")
  fiscalYear                  String?           @map("fiscal_year")
  isCancelled                 Boolean           @default(false) @map("is_cancelled")
  /// ERPNext's docstatus. Submitted on all but one: a 2024 entry of a cancelled reconciliation
  /// (MAT-RECO-2024-00247) kept docstatus 2 without is_cancelled. The reports skip both (docstatus < 2).
  docStatus                   PurchaseDocStatus @default(SUBMITTED) @map("doc_status")
  legacy                      Json?
  /// ERPNext's creation time: the last tie-break of the ledger's order.
  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")
  createdBy                   String?           @map("created_by")

  item      PurchaseItem?      @relation(fields: [itemId], references: [id])
  warehouse PurchaseWarehouse? @relation(fields: [warehouseId], references: [id])

  @@index([itemCode, warehouseCode, postingDateTime])
  @@index([postingDate])
  @@index([voucherType, voucherNo])
  @@map("purchase_stock_ledger_entries")
}

