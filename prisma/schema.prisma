/// Purchase Receipt (the GRN): receives a PO's items into stock.
model PurchaseReceipt {
  id                               String            @id @default(cuid())
  /// ERPNext name, e.g. "PR/25-26/MM-03446".
  number                           String            @unique
  title                            String?
  namingSeries                     String            @map("naming_series")
  docStatus                        PurchaseDocStatus @default(DRAFT) @map("doc_status")
  /// As ERPNext showed it: Draft, To Bill, Completed, Return Issued, Cancelled, Closed.
  status                           String
  amendedFromId                    String?           @map("amended_from_id")
  supplierCode                     String            @map("supplier_code")
  supplierId                       String?           @map("supplier_id")
  supplierName                     String?           @map("supplier_name")
  supplierDeliveryNote             String?           @map("supplier_delivery_note")
  billNo                           String?           @map("bill_no")
  billDate                         DateTime?         @map("bill_date") @db.Date
  postingDate                      DateTime          @map("posting_date") @db.Date
  /// As ERPNext stored it, "HH:MM:SS[.ffffff]".
  postingTime                      String            @map("posting_time")
  setPostingTime                   Boolean           @default(false) @map("set_posting_time")
  companyCode                      String            @map("company_code")
  currency                         String
  conversionRate                   Decimal           @default(1) @map("conversion_rate") @db.Decimal(21, 9)
  buyingPriceList                  String?           @map("buying_price_list")
