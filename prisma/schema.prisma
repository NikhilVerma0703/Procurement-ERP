/// The old site's users — who created, approved and changed each PO. The
/// history refers to them by email, as ERPNext did. (Logins are not here:
/// the standalone app's sign-in comes later; after the merge the Main ERP's.)
model PurchaseUser {
  email     String   @id
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  fullName  String?  @map("full_name")
  enabled   Boolean  @default(true)
  userType  String?  @map("user_type")
  /// ERPNext roles held (Has Role), e.g. "Purchase Head", "Admin".
  roles     String[] @default([])
  legacy    Json?

  @@map("purchase_users")
}

/// One run of the ERPNext importer: which backup, when, what it counted and
/// the reconciliation verdict — the audit trail of the data migration.
model PurchaseImportRun {
  id           String    @id @default(cuid())
  sourceFile   String    @map("source_file")
  sourceSha256 String    @map("source_sha256")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String
  counts       Json?
  report       Json?

  @@map("purchase_import_runs")
}

