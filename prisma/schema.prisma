  purchaseDate         DateTime? @map("purchase_date") @db.Date
  purchaseTime         String?   @map("purchase_time")
  purchaseRate         Decimal   @default(0) @map("purchase_rate") @db.Decimal(21, 9)
  deliveryDocumentType String?   @map("delivery_document_type")
  deliveryDocumentNo   String?   @map("delivery_document_no")
  deliveryDate         DateTime? @map("delivery_date") @db.Date
  deliveryTime         String?   @map("delivery_time")
  customerCode         String?   @map("customer_code")
  customerName         String?   @map("customer_name")
  salesInvoice         String?   @map("sales_invoice")
  companyCode          String    @map("company_code")
  status               String
  isScrap              Boolean   @default(false) @map("is_scrap")
  length               String?
  width                String?
  weight               String?
  defects              String?
  colorCode            String?   @map("color_code")
  thickness            String?
  grade                String?
  remarks              String?
  legacy               Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by")
  updatedBy            String?   @map("updated_by")

  item      PurchaseItem?      @relation(fields: [itemId], references: [id])
  warehouse PurchaseWarehouse? @relation(fields: [warehouseId], references: [id])

  @@index([itemId])
  @@index([batchNo])
  @@map("purchase_serial_nos")
}

model PurchaseBatch {
  id                    String    @id @default(cuid())
  /// The batch ID (= its ERPNext name).
  code                  String    @unique
  itemCode              String    @map("item_code")
  itemId                String?   @map("item_id")
  itemName              String?   @map("item_name")
  manufacturingDate     DateTime? @map("manufacturing_date") @db.Date
  batchQty              Decimal   @default(0) @map("batch_qty") @db.Decimal(21, 9)
  stockUom              String?   @map("stock_uom")
  useBatchwiseValuation Boolean   @default(false) @map("use_batchwise_valuation")
  legacy                Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdBy             String?   @map("created_by")
  updatedBy             String?   @map("updated_by")

  item PurchaseItem? @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("purchase_batches")
}

model PurchaseQualityInspection {
  id               String            @id @default(cuid())
  number           String            @unique
  namingSeries     String            @map("naming_series")
  docStatus        PurchaseDocStatus @default(DRAFT) @map("doc_status")
  reportDate       DateTime          @map("report_date") @db.Date
  status           String
  manualInspection Boolean           @default(false) @map("manual_inspection")
  inspectionType   String            @map("inspection_type")
  referenceType    String            @map("reference_type")
  referenceName    String            @map("reference_name")
  itemCode         String            @map("item_code")
  itemId           String?           @map("item_id")
  itemSerialNo     String?           @map("item_serial_no")
  batchNo          String?           @map("batch_no")
  sampleSize       Decimal           @default(0) @map("sample_size") @db.Decimal(21, 9)
  itemName         String?           @map("item_name")
  description      String?
  inspectedBy      String?           @map("inspected_by")
  verifiedBy       String?           @map("verified_by")
  amendedFromId    String?           @map("amended_from_id")
  legacy           Json?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  createdBy        String?           @map("created_by")
  updatedBy        String?           @map("updated_by")

  item        PurchaseItem?                      @relation(fields: [itemId], references: [id])
  amendedFrom PurchaseQualityInspection?         @relation("QualityInspectionAmendments", fields: [amendedFromId], references: [id])
  amendments  PurchaseQualityInspection[]        @relation("QualityInspectionAmendments")
  readings    PurchaseQualityInspectionReading[]

  @@index([referenceType, referenceName])
  @@map("purchase_quality_inspections")
}

model PurchaseQualityInspectionReading {
  id            String  @id @default(cuid())
  erpnextName   String  @unique @map("erpnext_name")
  inspectionId  String  @map("inspection_id")
  idx           Int
  specification String
  status        String?
  numeric       Boolean @default(false)
  /// The add-on's columns.
  bagWeight     Decimal @default(0) @map("bag_weight") @db.Decimal(21, 9)
  itemStatus    String? @map("item_status")
  legacy        Json?

  inspection PurchaseQualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("purchase_quality_inspection_readings")
}

// STANDALONE ONLY: sign-in accounts of the standalone app (plan §3 "Logins in
// standalone"). At the merge the Main ERP's users and roles take over and this
// table is not carried across (docs/05-list-screen.md). The import never
// touches it (migrate/load.ts KEEP_ON_RELOAD).
// ---------------------------------------------------------------------------

/// What a standalone login may do, mirroring the old site's workflow roles:
/// PURCHASE creates and edits drafts (ERPNext "Purchase Head"), APPROVER
/// approves and rejects (ERPNext "Admin"), ADMIN does everything.
enum PurchaseLoginRole {
  PURCHASE
  APPROVER
  ADMIN
  /// The storekeeper (Thiru R): Buying, and the Stock module (owner, 21-11-2026; docs/12 §6).
  STORE

  @@map("purchase_login_role")
}

model PurchaseLogin {
  id           String            @id @default(cuid())
  /// Lower-case; the sign-in name.
  email        String            @unique
  name         String
  role         PurchaseLoginRole
  /// bcrypt hash. The password itself is never stored or logged.
  passwordHash String            @map("password_hash")
  active       Boolean           @default(true)
  lastSignInAt DateTime?         @map("last_sign_in_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("purchase_logins")
}
