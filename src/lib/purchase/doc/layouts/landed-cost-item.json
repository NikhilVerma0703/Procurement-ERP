{
 "doctype": "Landed Cost Item",
 "module": "Stock",
 "istable": true,
 "issingle": false,
 "isSubmittable": false,
 "autoname": null,
 "showTitleFieldInLink": false,
 "titleField": null,
 "sortField": "modified",
 "sortOrder": "DESC",
 "searchFields": null,
 "defaultPrintFormat": null,
 "fields": [
  {
   "fieldname": "item_code",
   "label": "Item Code",
   "fieldtype": "Link",
   "options": "Item",
   "reqd": true,
   "readOnly": true,
   "inListView": true
  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Text Editor",
   "reqd": true,
   "readOnly": true,
   "inListView": true,
   "printWidth": "300px"
  },
  {
   "fieldname": "receipt_document_type",
   "label": "Receipt Document Type",
   "fieldtype": "Select",
   "options": "Purchase Invoice\nPurchase Receipt",
   "readOnly": true,
   "printHide": true,
   "noCopy": true
  },
  {
   "fieldname": "receipt_document",
   "label": "Receipt Document",
   "fieldtype": "Dynamic Link",
   "options": "receipt_document_type",
   "readOnly": true,
   "printHide": true,
   "noCopy": true
  },
  {
   "fieldname": "col_break2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "qty",
   "label": "Qty",
   "fieldtype": "Float",
   "readOnly": true,
   "inListView": true
  },
  {
   "fieldname": "rate",
   "label": "Rate",
   "fieldtype": "Currency",
   "options": "Company:company:default_currency",
   "readOnly": true
  },
  {
   "fieldname": "amount",
   "label": "Amount",
   "fieldtype": "Currency",
   "options": "Company:company:default_currency",
   "reqd": true,
   "readOnly": true,
   "inListView": true
  },
  {
   "fieldname": "is_fixed_asset",
   "label": "Is Fixed Asset",
   "fieldtype": "Check",
   "hidden": true,
   "readOnly": true,
   "fetchFrom": "item_code.is_fixed_asset"
  },
  {
   "fieldname": "applicable_charges",
   "label": "Applicable Charges",
   "fieldtype": "Currency",
   "options": "Company:company:default_currency",
   "readOnlyDependsOn": "eval:parent.distribute_charges_based_on != 'Distribute Manually'",
   "inListView": true
  },
  {
   "fieldname": "purchase_receipt_item",
   "label": "Purchase Receipt Item",
   "fieldtype": "Data",
   "hidden": true,
   "readOnly": true,
   "printHide": true,
   "noCopy": true
  },
  {
   "fieldname": "accounting_dimensions_section",
   "label": "Accounting Dimensions",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "cost_center",
   "label": "Cost Center",
   "fieldtype": "Link",
   "options": "Cost Center"
  },
  {
   "fieldname": "dimension_col_break",
   "fieldtype": "Column Break"
  }
 ]
}
