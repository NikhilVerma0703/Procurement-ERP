{
 "doctype": "Supplier",
 "module": "Buying",
 "istable": false,
 "issingle": false,
 "isSubmittable": false,
 "autoname": "naming_series:",
 "showTitleFieldInLink": false,
 "titleField": "supplier_name",
 "sortField": "modified",
 "sortOrder": "ASC",
 "searchFields": "supplier_name, supplier_group",
 "defaultPrintFormat": null,
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "SUP-.YYYY.-",
   "hidden": true,
   "noCopy": true
  },
  {
   "fieldname": "supplier_name",
   "label": "Supplier Name",
   "fieldtype": "Data",
   "reqd": true,
   "bold": true,
   "noCopy": true
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country"
  },
  {
   "fieldname": "column_break0",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "supplier_group",
   "label": "Supplier Group",
   "fieldtype": "Link",
   "options": "Supplier Group",
   "reqd": true,
   "inListView": true,
   "inStandardFilter": true
  },
  {
   "fieldname": "supplier_type",
   "label": "Supplier Type",
   "fieldtype": "Select",
   "options": "Company\nIndividual\nPartnership",
   "reqd": true,
   "default": "Company"
  },
  {
   "fieldname": "is_transporter",
   "label": "Is Transporter",
   "fieldtype": "Check"
  },
  {
   "fieldname": "image",
   "label": "Image",
   "fieldtype": "Attach Image",
   "hidden": true,
   "printHide": true,
   "noCopy": true
  },
  {
   "fieldname": "defaults_section",
   "label": "Defaults",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "default_currency",
   "label": "Billing Currency",
   "fieldtype": "Link",
   "options": "Currency",
   "noCopy": true
  },
  {
   "fieldname": "default_bank_account",
   "label": "Default Company Bank Account",
   "fieldtype": "Link",
   "options": "Bank Account"
  },
  {
   "fieldname": "column_break_10",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_price_list",
   "label": "Price List",
   "fieldtype": "Link",
   "options": "Price List"
  },
  {
