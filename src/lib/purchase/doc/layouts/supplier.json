   "fieldtype": "Check"
  },
  {
   "fieldname": "allow_purchase_invoice_creation_without_purchase_receipt",
   "label": "Allow Purchase Invoice Creation Without Purchase Receipt",
   "fieldtype": "Check"
  },
  {
   "fieldname": "column_break_54",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "is_frozen",
   "label": "Is Frozen",
   "fieldtype": "Check"
  },
  {
   "fieldname": "disabled",
   "label": "Disabled",
   "fieldtype": "Check",
   "bold": true
  },
  {
   "fieldname": "warn_rfqs",
   "label": "Warn RFQs",
   "fieldtype": "Check",
   "hidden": true,
   "readOnly": true
  },
  {
   "fieldname": "warn_pos",
   "label": "Warn POs",
   "fieldtype": "Check",
   "hidden": true,
   "readOnly": true
  },
  {
   "fieldname": "prevent_rfqs",
   "label": "Prevent RFQs",
   "fieldtype": "Check",
   "hidden": true,
   "readOnly": true
  },
  {
   "fieldname": "prevent_pos",
   "label": "Prevent POs",
   "fieldtype": "Check",
   "hidden": true,
   "readOnly": true
  },
  {
   "fieldname": "block_supplier_section",
   "label": "Block Supplier",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "on_hold",
   "label": "Block Supplier",
   "fieldtype": "Check"
  },
  {
   "fieldname": "hold_type",
   "label": "Hold Type",
   "fieldtype": "Select",
   "options": "\nAll\nInvoices\nPayments",
   "dependsOn": "eval:doc.on_hold"
  },
  {
   "fieldname": "column_break_59",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "release_date",
   "label": "Release Date",
   "fieldtype": "Date",
   "dependsOn": "eval:doc.on_hold",
   "description": "Leave blank if the Supplier is blocked indefinitely"
  }
 ]
}
