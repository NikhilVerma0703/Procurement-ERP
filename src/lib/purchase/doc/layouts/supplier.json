   "fieldtype": "Link",
   "options": "Contact",
   "description": "Reselect, if the chosen contact is edited after save"
  },
  {
   "fieldname": "mobile_no",
   "label": "Mobile No",
   "fieldtype": "Read Only",
   "fetchFrom": "supplier_primary_contact.mobile_no"
  },
  {
   "fieldname": "email_id",
   "label": "Email Id",
   "fieldtype": "Read Only",
   "fetchFrom": "supplier_primary_contact.email_id"
  },
  {
   "fieldname": "column_break_44",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "supplier_primary_address",
   "label": "Supplier Primary Address",
   "fieldtype": "Link",
   "options": "Address",
   "description": "Reselect, if the chosen address is edited after save"
  },
  {
   "fieldname": "primary_address",
   "label": "Primary Address",
   "fieldtype": "Text",
   "readOnly": true
  },
  {
   "fieldname": "accounting_tab",
   "label": "Accounting",
   "fieldtype": "Tab Break"
