  stockQty         Decimal @default(0) @map("stock_qty") @db.Decimal(21, 9)

  priceListRate      Decimal             @default(0) @map("price_list_rate") @db.Decimal(21, 9)
  basePriceListRate  Decimal             @default(0) @map("base_price_list_rate") @db.Decimal(21, 9)
  lastPurchaseRate   Decimal             @default(0) @map("last_purchase_rate") @db.Decimal(21, 9)
  marginType         PurchaseMarginType? @map("margin_type")
