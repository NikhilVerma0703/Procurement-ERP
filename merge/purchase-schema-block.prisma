  igstRate           Decimal @default(0) @map("igst_rate") @db.Decimal(21, 9)
  cgstRate           Decimal @default(0) @map("cgst_rate") @db.Decimal(21, 9)
  sgstRate           Decimal @default(0) @map("sgst_rate") @db.Decimal(21, 9)
  cessRate           Decimal @default(0) @map("cess_rate") @db.Decimal(21, 9)
  cessNonAdvolRate   Decimal @default(0) @map("cess_non_advol_rate") @db.Decimal(21, 9)
  igstAmount         Decimal @default(0) @map("igst_amount") @db.Decimal(21, 9)
  cgstAmount         Decimal @default(0) @map("cgst_amount") @db.Decimal(21, 9)
  sgstAmount         Decimal @default(0) @map("sgst_amount") @db.Decimal(21, 9)
  cessAmount         Decimal @default(0) @map("cess_amount") @db.Decimal(21, 9)
  cessNonAdvolAmount Decimal @default(0) @map("cess_non_advol_amount") @db.Decimal(21, 9)

  // The add-on's grid columns (SGST %/Amt, CGST %/Amt, IGST %/Amt) — printed on the PO sheet
  sgst    Decimal @default(0) @db.Decimal(21, 9)
  sgstAmt Decimal @default(0) @map("sgst_amt") @db.Decimal(21, 9)
  cgst    Decimal @default(0) @db.Decimal(21, 9)
  cgstAmt Decimal @default(0) @map("cgst_amt") @db.Decimal(21, 9)
  igst    Decimal @default(0) @db.Decimal(21, 9)
  igstAmt Decimal @default(0) @map("igst_amt") @db.Decimal(21, 9)

  warehouseId       String? @map("warehouse_id")
  fromWarehouse     String? @map("from_warehouse")
  /// Stock at the time the line was entered (ERPNext fills these).
  actualQty         Decimal @default(0) @map("actual_qty") @db.Decimal(21, 9)
  companyTotalStock Decimal @default(0) @map("company_total_stock") @db.Decimal(21, 9)
  expenseAccountId  String? @map("expense_account_id")
  costCenterId      String? @map("cost_center_id")
  project           String?

  /// Source documents, kept as references (those modules are not replicated).
  materialRequest       String? @map("material_request")
  materialRequestItem   String? @map("material_request_item")
  salesOrder            String? @map("sales_order")
  salesOrderItem        String? @map("sales_order_item")
  supplierQuotation     String? @map("supplier_quotation")
  supplierQuotationItem String? @map("supplier_quotation_item")
  deliveredBySupplier   Boolean @default(false) @map("delivered_by_supplier")
  blanketOrder          String? @map("blanket_order")

  // Fulfilment, as recorded by the receipts and invoices against this line
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(21, 9)
  returnedQty Decimal @default(0) @map("returned_qty") @db.Decimal(21, 9)
  billedAmt   Decimal @default(0) @map("billed_amt") @db.Decimal(21, 9)

  manufacturer       String?
  manufacturerPartNo String? @map("manufacturer_part_no")
  bom                String?
  weightPerUnit      Decimal @default(0) @map("weight_per_unit") @db.Decimal(21, 9)
  totalWeight        Decimal @default(0) @map("total_weight") @db.Decimal(21, 9)
  weightUom          String? @map("weight_uom")
  isFixedAsset       Boolean @default(false) @map("is_fixed_asset")
  pageBreak          Boolean @default(false) @map("page_break")

  legacy Json?

  order           PurchaseOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            PurchaseItem             @relation(fields: [itemId], references: [id])
  uomRef          PurchaseUom              @relation("OrderItemUom", fields: [uom], references: [name])
  stockUomRef     PurchaseUom              @relation("OrderItemStockUom", fields: [stockUom], references: [name])
  itemTaxTemplate PurchaseItemTaxTemplate? @relation(fields: [itemTaxTemplateId], references: [id])
  warehouse       PurchaseWarehouse?       @relation(fields: [warehouseId], references: [id])
  expenseAccount  PurchaseAccount?         @relation(fields: [expenseAccountId], references: [id])
  costCenter      PurchaseCostCenter?      @relation(fields: [costCenterId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model PurchaseOrderTax {
  id                               String                 @id @default(cuid())
  erpnextName                      String?                @unique @map("erpnext_name")
  orderId                          String                 @map("order_id")
  idx                              Int
  category                         PurchaseTaxConsiderFor @default(TOTAL)
  addDeductTax                     PurchaseTaxAddDeduct   @default(ADD) @map("add_deduct_tax")
  chargeType                       PurchaseTaxChargeType  @map("charge_type")
  /// For "On Previous Row …" charges: the referenced row's idx.
  rowId                            Int?                   @map("row_id")
  includedInPrintRate              Boolean                @default(false) @map("included_in_print_rate")
  includedInPaidAmount             Boolean                @default(false) @map("included_in_paid_amount")
  accountHeadId                    String                 @map("account_head_id")
  description                      String?                @db.Text
  rate                             Decimal                @default(0) @db.Decimal(21, 9)
  costCenterId                     String?                @map("cost_center_id")
  accountCurrency                  String?                @map("account_currency")
  taxAmount                        Decimal                @default(0) @map("tax_amount") @db.Decimal(21, 9)
  taxAmountAfterDiscountAmount     Decimal                @default(0) @map("tax_amount_after_discount_amount") @db.Decimal(21, 9)
  total                            Decimal                @default(0) @db.Decimal(21, 9)
  baseTaxAmount                    Decimal                @default(0) @map("base_tax_amount") @db.Decimal(21, 9)
  baseTotal                        Decimal                @default(0) @map("base_total") @db.Decimal(21, 9)
  baseTaxAmountAfterDiscountAmount Decimal                @default(0) @map("base_tax_amount_after_discount_amount") @db.Decimal(21, 9)
  /// ERPNext's per-item split of this tax {item_code: [rate, amount]}, as stored.
  itemWiseTaxDetail                Json?                  @map("item_wise_tax_detail")
  /// Add-on: the Cost Overhead charge this row's GST was computed on.
  servicePrice                     Decimal                @default(0) @map("service_price") @db.Decimal(21, 9)
  gstTaxType                       String?                @map("gst_tax_type")
  legacy                           Json?

  order       PurchaseOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accountHead PurchaseAccount     @relation(fields: [accountHeadId], references: [id])
  costCenter  PurchaseCostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([orderId])
  @@map("purchase_order_taxes")
}

/// The add-on's "Cost Overheads" table (ERPNext child DocType "Services Items").
model PurchaseOrderCostOverhead {
  id             String   @id @default(cuid())
  erpnextName    String?  @unique @map("erpnext_name")
  orderId        String   @map("order_id")
  idx            Int
  serviceItemId  String?  @map("service_item_id")
  /// Stored as text by the add-on; numeric here (the importer parses it).
  serviceCharges Decimal? @map("service_charges") @db.Decimal(21, 9)
  accountHeadId  String?  @map("account_head_id")
  chargeType     String   @default("Actual") @map("charge_type")
  legacy         Json?

  order       PurchaseOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceItem PurchaseItem?    @relation(fields: [serviceItemId], references: [id])
  accountHead PurchaseAccount? @relation(fields: [accountHeadId], references: [id])

  @@index([orderId])
  @@map("purchase_order_cost_overheads")
}

model PurchaseOrderPaymentSchedule {
  id                      String    @id @default(cuid())
  erpnextName             String?   @unique @map("erpnext_name")
  orderId                 String    @map("order_id")
  idx                     Int
  /// As written on the PO (shown in its Payment Schedule); paymentTermId when
  /// it names a Payment Term record (2 historical rows name renamed terms).
  paymentTermName         String?   @map("payment_term_name")
  paymentTermId           String?   @map("payment_term_id")
  description             String?   @db.Text
  dueDate                 DateTime  @map("due_date") @db.Date
  modeOfPayment           String?   @map("mode_of_payment")
  invoicePortion          Decimal   @default(0) @map("invoice_portion") @db.Decimal(21, 9)
  discountType            String?   @map("discount_type")
  discountDate            DateTime? @map("discount_date") @db.Date
  discount                Decimal   @default(0) @db.Decimal(21, 9)
  paymentAmount           Decimal   @default(0) @map("payment_amount") @db.Decimal(21, 9)
  outstanding             Decimal   @default(0) @db.Decimal(21, 9)
  paidAmount              Decimal   @default(0) @map("paid_amount") @db.Decimal(21, 9)
  discountedAmount        Decimal   @default(0) @map("discounted_amount") @db.Decimal(21, 9)
  basePaymentAmount       Decimal   @default(0) @map("base_payment_amount") @db.Decimal(21, 9)
  dueDateBasedOn          String?   @map("due_date_based_on")
  creditDays              Int       @default(0) @map("credit_days")
  creditMonths            Int       @default(0) @map("credit_months")
  discountValidityBasedOn String?   @map("discount_validity_based_on")
  discountValidity        Int       @default(0) @map("discount_validity")
  legacy                  Json?

  order       PurchaseOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTerm PurchasePaymentTerm? @relation(fields: [paymentTermId], references: [id])

  @@index([orderId])
  @@map("purchase_order_payment_schedules")
}

/// Documents of other modules made against a PO — what its Connections tab
/// lists (Purchase Receipt, Purchase Invoice, Material Request, …). Those
/// modules are not replicated; their links and key facts are kept.
model PurchaseOrderLink {
  id        String    @id @default(cuid())
  orderId   String    @map("order_id")
  docType   String    @map("doc_type")
  docName   String    @map("doc_name")
  docDate   DateTime? @map("doc_date") @db.Date
  docStatus String?   @map("doc_status")
  /// Line-level facts from the linked document (e.g. received qty per PO line).
  detail    Json?

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, docType, docName])
  @@index([docType, docName])
  @@map("purchase_order_links")
}

/// A PO's timeline: changes (ERPNext Version), workflow actions and labels,
/// comments and attachment notes (Comment), emails sent (Communication).
/// Deleted drafts are kept too: their last state lives in `data`, with
/// `orderNumber` set and `orderId` empty.
model PurchaseOrderEvent {
  id          String                 @id @default(cuid())
  erpnextName String?                @unique @map("erpnext_name")
  source      String
  orderId     String?                @map("order_id")
  orderNumber String                 @map("order_number")
  kind        PurchaseOrderEventKind
  at          DateTime
  byEmail     String?                @map("by_email")
  subject     String?                @db.Text
  content     String?                @db.Text
  data        Json?

  order PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, at])
  @@index([orderNumber])
  @@map("purchase_order_events")
}

model PurchaseAttachment {
  id          String   @id @default(cuid())
  erpnextName String?  @unique @map("erpnext_name")
  orderId     String?  @map("order_id")
  fileName    String   @map("file_name")
  /// Where the old site served it (/files/… or /private/files/…).
  fileUrl     String   @map("file_url")
  isPrivate   Boolean  @default(false) @map("is_private")
  fileSize    Int?     @map("file_size")
  contentHash String?  @map("content_hash")
  /// Where this system keeps the bytes (relative to its file store).
  storagePath String?  @map("storage_path")
  uploadedBy  String?  @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  order PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("purchase_attachments")
}

/// The module's file store (server/files.ts): the bytes of PO attachments and of the letter-head
/// logo the sheets print, by their place ("files/private/x.pdf", an attachment's storage_path).
/// In the database, as the Main ERP keeps uploaded files: it runs on Vercel, with no lasting disk.
model PurchaseFile {
  path      String   @id
  bytes     Bytes
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("purchase_files")
}

/// Likes: the ♥ on a list row and in a form's sidebar (Frappe's _liked_by, which ERPNext kept on
/// each record): who liked which PO or master, by doctype ("Purchase Order", "Supplier", …) and
/// the record's id. Brought back by the owner's decision of 19-11-2026.
model PurchaseLike {
  id       String   @id @default(cuid())
  doctype  String
  recordId String   @map("record_id")
  email    String
  likedAt  DateTime @default(now()) @map("liked_at")

  @@unique([doctype, recordId, email])
  @@index([email])
  @@map("purchase_likes")
}

// ---------------------------------------------------------------------------
// People and migration runs
// ---------------------------------------------------------------------------

/// The old site's users — who created, approved and changed each PO. The
/// history refers to them by email, as ERPNext did. (Logins are not here:
/// the standalone app's sign-in comes later; after the merge the Main ERP's.)
model PurchaseUser {
  email     String   @id
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  fullName  String?  @map("full_name")
  enabled   Boolean  @default(true)
  userType  String?  @map("user_type")
  /// ERPNext roles held (Has Role), e.g. "Purchase Head", "Admin".
  roles     String[] @default([])
  legacy    Json?

  @@map("purchase_users")
}

/// One run of the ERPNext importer: which backup, when, what it counted and
/// the reconciliation verdict — the audit trail of the data migration.
model PurchaseImportRun {
  id           String    @id @default(cuid())
  sourceFile   String    @map("source_file")
  sourceSha256 String    @map("source_sha256")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String
  counts       Json?
  report       Json?

  @@map("purchase_import_runs")
}
