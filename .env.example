# Copy to .env and put your local Postgres password in place of <password>.
# Both variables are required (Prisma reads DIRECT_URL for migrations).

# Local development: a PostgreSQL database on this machine.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/procurement_erp?schema=public"
DIRECT_URL="postgresql://postgres:<password>@localhost:5432/procurement_erp?schema=public"

# Production (Neon): DATABASE_URL is the pooled (-pooler) connection string,
# DIRECT_URL the direct one. Not used while the app is standalone.

# Signs the session cookies of the standalone sign-in. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<random string>"

# Outgoing email (Step 8), the same variables as the Main ERP. Without them nothing is sent:
# emails written from a PO stay "Not Sent" on its timeline.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="<mailbox>"
# SMTP_PASS="<password>"
# SMTP_FROM="\"Pacific Surfaces\" <purchase@example.com>"

# The old site's three PO notifications (created / approved). Off unless "on": the old site
# last sent one on 21-09-2024, so switching them on is the owner's decision.
# PURCHASE_NOTIFICATIONS="on"
